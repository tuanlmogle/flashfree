rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /progress/{chunk} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /prefs/{chunk} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // A new account may create its own referral under the inviter, once.
      // Only the inviter can read the list. Nobody can edit or delete it.
      match /referrals/{newUid} {
        allow create: if request.auth != null
          && request.auth.uid == newUid
          && newUid != uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is timestamp;
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }
  }
}
